{
  "manifest_version": 3,
  "name": "CEP Local DLP Companion (BYOD Gatekeeper & Bootstrapper)",
  "version": "1.1.0",
  "description": "Provisions and enforces the Chrome Enterprise Premium (CEP) Local DLP Agent on BYOD and managed endpoints.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms",
    "tabs",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "http://127.0.0.1:8843/*",
    "http://localhost:8843/*",
    "<all_urls>"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CEP Local DLP Agent Status"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "onboarding.html",
        "onboarding.css",
        "onboarding.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
